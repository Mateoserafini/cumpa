# ====================================================
# CONFIGURACIÓN DEL SERVIDOR (NODE.JS + EXPRESS + TS)
# ====================================================

# Puerto en el que corre la API (en Render/Railway es asignado dinámicamente)
PORT=3000

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=development

# URL(s) del Frontend autorizadas para CORS (separadas por coma si hay más de una)
# En desarrollo: http://localhost:5173
# En producción: https://tu-frontend-cumpa.vercel.app,https://tu-dominio.com
FRONTEND_URL="http://localhost:5173"

# ====================================================
# BASE DE DATOS POSTGRESQL (NEON / SUPABASE)
# ====================================================
# Cadena de conexión JDBC/PostgreSQL provista por Neon o Supabase
# En Neon: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cumpa?schema=public"

# ====================================================
# AUTENTICACIÓN JWT (JSON WEB TOKENS)
# ====================================================
# Clave secreta robusta de al menos 32 caracteres generada aleatoriamente
JWT_SECRET="cumpa_jwt_secret_dev_key_change_in_production"
JWT_EXPIRES_IN="7d"

# ====================================================
# GOOGLE OAUTH 2.0 (OPCIONAL EN LOCAL, REQUERIDO PARA SOCIAL LOGIN)
# ====================================================
# Obtenidos en Google Cloud Console -> APIs y Servicios -> Credenciales
GOOGLE_CLIENT_ID="tu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"
# URL de callback autorizada registrada en Google Console
# En local: http://localhost:3000/api/auth/google/callback
# En producción: https://tu-backend-cumpa.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ====================================================
# ALMACENAMIENTO MULTIMEDIA (CLOUDINARY)
# ====================================================
# Obtenidos del Dashboard de Cloudinary (Plan Gratuito)
# Si no se configuran, la app opera en 'Modo Fallback' generando URLs simuladas
CLOUDINARY_CLOUD_NAME="tu_cloudinary_cloud_name"
CLOUDINARY_API_KEY="tu_cloudinary_api_key"
CLOUDINARY_API_SECRET="tu_cloudinary_api_secret"

# ====================================================
# SERVICIO DE CORREO TRANSACCIONAL (GMAIL SMTP / NODEMAILER)
# ====================================================
# Configura tu cuenta de Gmail y una Contraseña de Aplicación de Google (16 caracteres).
# Si no se configuran SMTP_USER y SMTP_PASS, los emails se imprimen en consola (Modo Mock).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion_google"
EMAIL_FROM="Cumpa <tu_correo@gmail.com>"
