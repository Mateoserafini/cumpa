PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de datos (PostgreSQL / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cumpa?schema=public"

# Autenticación JWT
JWT_SECRET="cumpa_jwt_secret_dev_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Google OAuth
GOOGLE_CLIENT_ID="tu_google_client_id"
GOOGLE_CLIENT_SECRET="tu_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Almacenamiento multimedia (Cloudinary)
CLOUDINARY_CLOUD_NAME="tu_cloudinary_cloud_name"
CLOUDINARY_API_KEY="tu_cloudinary_api_key"
CLOUDINARY_API_SECRET="tu_cloudinary_api_secret"

# Servicio de Correo Electrónico (Resend)
RESEND_API_KEY="tu_resend_api_key"
