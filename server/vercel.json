{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/followup-reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/nightly-maintenance",
      "schedule": "5 3 * * *"
    }
  ]
}
